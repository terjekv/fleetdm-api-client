FLEET_URL=https://fleet.example.com
FLEET_TOKEN=replace-with-fleet-api-token
FLEET_USERS_PER_PAGE=500

LDAP_URL=ldaps://ldap.example.com:636
LDAP_BIND_DN=uid=fleet-sync,ou=svc,dc=example,dc=com
LDAP_BIND_PASSWORD=replace-with-ldap-bind-password
LDAP_GROUP_MEMBER_ATTRIBUTE=memberUid
LDAP_GROUPS_FOR_ADMIN=["cn=fleet-admins,ou=groups,dc=example,dc=com"]
LDAP_GROUPS_FOR_MAINTAINER=["cn=fleet-maintainers-platform,ou=groups,dc=example,dc=com","cn=fleet-maintainers-security,ou=groups,dc=example,dc=com"]
LDAP_GROUPS_FOR_OBSERVER=["cn=fleet-observers-finance,ou=groups,dc=example,dc=com","cn=fleet-observers-support,ou=groups,dc=example,dc=com","cn=fleet-observers-qa,ou=groups,dc=example,dc=com"]
LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=com
# LDAP_USER_SEARCH_BASE_DN=ou=people,dc=example,dc=com
# LDAP_USER_LOOKUP_FILTER_TEMPLATE=(uid={username})
LDAP_USER_EMAIL_ATTRIBUTE=mail

LDAP_SYNC_CLEANUP_SSO=true
# SYNC_INTERVAL_SECONDS=3600
